{
  "model": {
    "vocab_size": 32000,
    "context_length": 448,
    "d_model": 768,
    "num_layers": 12,
    "num_heads": 8,
    "d_ff": 2048,
    "rope_theta": 500000.0,
    "use_qk_norm": true,
    "use_unet_residual": true,
    "unet_gate_init": 0.18
  },
  "optimizer": {
    "name": "muon",
    "lr": 0.0004,
    "depth_mu_enabled": true,
    "depth_mu_base_lr": 0.0004,
    "depth_mu_reference_depth": 12,
    "betas": [0.9, 0.95],
    "eps": 1e-8,
    "weight_decay": 0.1,
    "matrix_weight_decay": 0.1,
    "vector_weight_decay": 0.0,
    "vector_lr_multiplier": 1.0,
    "muon_momentum": 0.95,
    "muon_momentum_min": 0.8,
    "muon_momentum_max": 0.95,
    "muon_warmup_steps": 400,
    "muon_ns_steps": 5
  },
  "training": {
    "total_steps": 20000,
    "batch_size": 256,
    "grad_accum_steps": 3,
    "seed": 7,
    "device": "cuda",
    "precision": "bfloat16",
    "grad_clip_norm": 1.0,
    "step_interval": 1,
    "eval_interval": 300,
    "eval_batches": 24,
    "use_torch_compile": false,
    "compile_mode": "reduce-overhead",
    "use_gradient_checkpointing": true
  },
  "data": {
    "train_path": "/data0/data1/owt_train.npy",
    "val_path": "/data0/data1/owt_valid.npy",
    "dtype": "uint16"
  },
  "checkpoint": {
    "checkpoint_dir": "./checkpoints/owt_deep_wide",
    "save_interval": 1000,
    "max_to_keep": 3
  },
  "logging": {
    "log_interval": 50,
    "use_wandb": true,
    "project": "cs336-owt",
    "entity": "vilhelm-toivonen-helsinki-university",
    "run_name": "owt-deep-wide"
  },
  "lr_schedule": {
    "enabled": true,
    "schedule_type": "linear_to_zero",
    "warmup_tokens": 25000000
  }
}
