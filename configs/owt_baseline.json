{
  "model": {
    "vocab_size": 32000,
    "context_length": 256,
    "d_model": 512,
    "num_layers": 4,
    "num_heads": 16,
    "d_ff": 1344,
    "rope_theta": 500000.0
  },
  "optimizer": {
    "name": "adamw",
    "lr": 0.003,
    "betas": [0.9, 0.999],
    "eps": 1e-8,
    "weight_decay": 0.01,
    "dtype": "float32"
  },
  "training": {
    "total_steps": 20000,
    "batch_size": 128,
    "grad_accum_steps": 1,
    "seed": 42,
    "device": "cuda",
    "precision": "bfloat16",
    "grad_clip_norm": 1.0,
    "step_interval": 1,
    "eval_interval": 250,
    "eval_batches": 20
  },
  "data": {
    "train_path": "/workspace/data/owt_train.npy",
    "val_path": "/workspace/data/owt_valid.npy",
    "dtype": "uint16"
  },
  "checkpoint": {
    "checkpoint_dir": "/scratch/project_2013932/vtoivone/checkpoints/owt_baseline",
    "save_interval": 1000,
    "max_to_keep": 3
  },
  "logging": {
    "log_interval": 50,
    "use_wandb": true,
    "project": "cs336-owt",
    "entity": "vilhelm-toivonen-helsinki-university",
    "run_name": "baseline"
  },
  "lr_schedule": {
    "enabled": true,
    "alpha_max": 0.003,
    "alpha_min": 0.0003,
    "warmup_steps": 500,
    "cosine_steps": 8000
  }
}
