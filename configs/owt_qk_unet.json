{
  "model": {
    "vocab_size": 32000,
    "context_length": 256,
    "d_model": 512,
    "num_layers": 4,
    "num_heads": 8,
    "d_ff": 1536,
    "rope_theta": 500000.0,
    "use_qk_norm": true,
    "use_unet_residual": true,
    "unet_gate_init": 0.2
  },
  "optimizer": {
    "name": "adamw",
    "lr": 0.0025,
    "betas": [
      0.9,
      0.99
    ],
    "eps": 1e-08,
    "weight_decay": 0.0125,
    "dtype": "float32"
  },
  "training": {
    "total_steps": 20000,
    "batch_size": 192,
    "grad_accum_steps": 1,
    "seed": 42,
    "device": "cuda",
    "precision": "bfloat16",
    "grad_clip_norm": 1.0,
    "step_interval": 1,
    "eval_interval": 250,
    "eval_batches": 20,
    "use_torch_compile": true,
    "compile_mode": "reduce-overhead"
  },
  "data": {
    "train_path": "/workspace/data/owt_train.npy",
    "val_path": "/workspace/data/owt_valid.npy",
    "dtype": "uint16"
  },
  "checkpoint": {
    "checkpoint_dir": "./checkpoints/owt_qk_unet",
    "save_interval": 4000,
    "max_to_keep": 1
  },
  "logging": {
    "log_interval": 50,
    "use_wandb": true,
    "project": "cs336-owt",
    "entity": "vilhelm-toivonen-helsinki-university",
    "run_name": "owt-qk-unet"
  },
  "lr_schedule": {
    "enabled": true,
    "alpha_max": 0.0025,
    "alpha_min": 0.0003,
    "warmup_steps": 800,
    "cosine_steps": 18000
  }
}
