{
  "model": {
    "context_length": 1024,
    "d_model": 768,
    "num_layers": 12,
    "num_heads": 6,
    "d_ff": 3072,
    "rope_theta": 10000.0,
    "use_rope": true,
    "use_pre_norm": true,
    "use_post_norm": false,
    "use_rmsnorm": true,
    "use_swiglu": false,
    "use_qk_norm": true,
    "use_unet_residual": true,
    "unet_gate_init": -1.5,
    "use_x0_mixin": true,
    "x0_gate_init": 0.12,
    "tie_embeddings": false,
    "use_value_embeddings": true,
    "num_value_embeddings": 3,
    "value_embed_lr_mul": 35,
    "sa_lambda_init": [
      0.5,
      0.5
    ],
    "sa_lambda_lr_mul": 5.0,
    "use_smear": true,
    "smear_lambda_init": 0.0,
    "smear_gate_dim": 12,
    "use_attn_gate": true,
    "attn_gate_dim": 12,
    "attn_gate_lr_mul": 5.0
  },
  "optimizer": {
    "name": "muon",
    "lr": 0.008,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-8,
    "weight_decay": 0.001,
    "matrix_weight_decay": 0.001,
    "vector_weight_decay": 0.001,
    "vector_lr_multiplier": 1.0,
    "vector_lr_ratio": 0.1,
    "muon_momentum": 0.95,
    "muon_momentum_min": 0.85,
    "muon_momentum_max": 0.95,
    "muon_warmup_steps": 280,
    "muon_momentum_cooldown_steps": 180,
    "muon_ns_steps": 5,
    "matrix_base_lr": 0.07,
    "vector_base_lr": null,
    "muon_lr_decay_start": null,
    "muon_lr_decay_end": null,
    "muon_lr_decay_start_tokens": 300000000,
    "muon_lr_decay_end_tokens": 700000000,
    "muon_lr_final": 0.0045,
    "muon_lr_warmup_steps": 280,
    "muon_lr_warmup_start": 0.0055,
    "muon_lr_warmup_tokens": null,
    "muon_momentum_warmup_tokens": 70000000,
    "muon_momentum_cooldown_tokens": null,
    "matrix_state_dtype": "bfloat16",
    "vector_state_dtype": null
  },
  "training": {
    "total_steps": 2200,
    "batch_size": 56,
    "grad_accum_steps": 2,
    "seed": 7,
    "device": "cuda",
    "precision": "bfloat16",
    "grad_clip_norm": null,
    "step_interval": 1,
    "eval_interval": 200,
    "eval_batches": 80,
    "eval_batch_size": null,
    "eval_full_sweep": false,
    "eval_stride": null,
    "eval_shuffle_documents": false,
    "eval_limit_windows": null,
    "use_torch_compile": true,
    "compile_mode": "default",
    "use_gradient_checkpointing": false,
    "logit_softcap": 20.0,
    "z_loss_weight": 1e-5,
    "softcap_warmup_steps": 0,
    "zloss_warmup_steps": 0,
    "num_workers": 4,
    "pin_memory": true,
    "persistent_workers": true,
    "align_to_bos": false,
    "compile_warmup_steps": 5,
    "ema_decay": null,
    "ema_update_interval": 1,
    "use_ema_for_eval": false,
    "grad_accum_reference": 16,
    "grad_accum_schedule": null,
    "grad_accum_minutes_schedule": [
      {"minute": 0, "value": 2},
      {"minute": 15, "value": 4},
      {"minute": 35, "value": 8},
      {"minute": 70, "value": 16},
      {"minute": 75, "value": 16}
  ],
    "softcap_warmup_tokens": 0,
    "zloss_warmup_tokens": 0
  },
  "data": {
    "train_path": "/data/data1/owt_train.npy",
    "val_path": "/data/data1/owt_valid.npy",
    "dtype": "uint16",
    "bos_token_id": null
  },
  "checkpoint": {
    "checkpoint_dir": "./checkpoints/owt_speedrun_sub3_final",
    "save_interval": 1000,
    "max_to_keep": 3,
    "resume_path": null
  },
  "logging": {
    "log_interval": 10,
    "use_wandb": true,
    "project": "cs336-owt",
    "entity": "vilhelm-toivonen-helsinki-university",
    "run_name": "owt_speedrun_sub3_final",
    "mode": "online"
  },
  "lr_schedule": {
    "enabled": false,
    "alpha_max": null,
    "alpha_min": null,
    "warmup_steps": 0,
    "cosine_steps": null,
    "schedule_type": "cosine",
    "warmup_tokens": null,
    "decay_tokens": null,
    "cosine_tokens": null
  }
