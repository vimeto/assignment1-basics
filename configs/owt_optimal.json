{
  "model": {
    "vocab_size": 32000,
    "context_length": 512,
    "d_model": 1024,
    "num_layers": 12,
    "num_heads": 8,
    "d_ff": 2688,
    "rope_theta": 500000.0,
    "use_qk_norm": true,
    "use_unet_residual": true,
    "unet_gate_init": 0.18
  },
  "optimizer": {
    "name": "muon",
    "lr": 0.0005,
    "betas": [0.9, 0.999],
    "eps": 1e-8,
    "weight_decay": 0.00012,
    "matrix_weight_decay": 0.00012,
    "vector_weight_decay": 0.0,
    "vector_lr_multiplier": 1,
    "muon_momentum": 0.96,
    "muon_momentum_min": 0.90,
    "muon_momentum_max": 0.96,
    "muon_warmup_steps": 800,
    "muon_ns_steps": 5,
    "matrix_base_lr": 0.0175,
    "vector_base_lr": 0.0016,
    "muon_lr_decay_start": 1200,
    "muon_lr_decay_end": 18000,
    "muon_lr_final": 0.003
  },
  "training": {
    "total_steps": 20000,
    "batch_size": 128,
    "grad_accum_steps": 2,
    "seed": 7,
    "device": "cuda",
    "precision": "bfloat16",
    "grad_clip_norm": 1.0,
    "step_interval": 1,
    "eval_interval": 300,
    "eval_batches": 24,
    "eval_batch_size": 96,
    "use_torch_compile": true,
    "compile_mode": "reduce-overhead",
    "use_gradient_checkpointing": true,
    "logit_softcap": 15.0,
    "z_loss_weight": 1e-4,
    "softcap_warmup_steps": 800,
    "zloss_warmup_steps": 800
  },
  "data": {
    "train_path": "/data0/data1/owt_train.npy",
    "val_path": "/data0/data1/owt_valid.npy",
    "dtype": "uint16"
  },
  "checkpoint": {
    "checkpoint_dir": "./checkpoints/owt_optimal",
    "save_interval": 1000,
    "max_to_keep": 3
  },
  "logging": {
    "log_interval": 50,
    "use_wandb": true,
    "project": "cs336-owt",
    "entity": "vilhelm-toivonen-helsinki-university",
    "run_name": "owt_optimal_2"
  },
  "lr_schedule": {
    "enabled": true,
    "schedule_type": "cosine",
    "alpha_max": 0.0016,
    "alpha_min": 0.0001,
    "warmup_steps": 800,
    "cosine_steps": 20000
  }
}
