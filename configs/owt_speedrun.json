{
  "model": {
    "context_length": 768,
    "d_model": 768,
    "num_layers": 12,
    "num_heads": 6,
    "d_ff": 3072,
    "use_qk_norm": true,
    "use_rmsnorm": true,
    "use_pre_norm": true,
    "unet_gate_init": -1.5,
    "use_x0_mixin": true,
    "x0_gate_init": 0.1,
    "attn_gate_dim": 12,
    "use_attn_gate": false,
    "use_post_norm": false,
    "sa_lambda_init": [0.5, 0.5],
    "smear_gate_dim": 12,
    "tie_embeddings": false,
    "attn_gate_lr_mul": 5,
    "sa_lambda_lr_mul": 5,
    "smear_lambda_init": 0,
    "use_unet_residual": true,
    "use_value_embeddings": true,
    "num_value_embeddings": 3,
    "value_embed_lr_mul": 25,
    "use_smear": true,
    "use_swiglu": false
  },
  "optimizer": {
    "name": "muon",
    "lr": 0.008,
    "betas": [0.9, 0.999],
    "eps": 1e-8,
    "weight_decay": 0.001,
    "matrix_weight_decay": 0.001,
    "vector_weight_decay": 0.001,
    "matrix_base_lr": 0.08,
    "vector_base_lr": null,
    "vector_lr_ratio": 0.1,
    "muon_ns_steps": 5,
    "muon_momentum": 0.95,
    "muon_momentum_min": 0.8,
    "muon_momentum_max": 0.95,
    "muon_warmup_steps": 250,
    "muon_lr_warmup_start": 0.005,
    "muon_lr_final": 0.001,
    "muon_lr_decay_start_tokens": 50000000,
    "muon_lr_decay_end_tokens": 700000000,
    "muon_momentum_warmup_tokens": 100000000,
    "muon_momentum_cooldown_steps": 400,
    "muon_lr_warmup_tokens": null,
    "muon_lr_decay_start": null,
    "muon_lr_decay_end": null,
    "matrix_state_dtype": "bfloat16",
    "vector_state_dtype": null
  },
  "training": {
    "seed": 7,
    "device": "cuda",
    "precision": "bfloat16",
    "batch_size": 64,
    "total_steps": 3500,
    "grad_accum_steps": 2,
    "grad_accum_reference": 8,
    "use_torch_compile": true,
    "compile_mode": "default",
    "compile_warmup_steps": 5,
    "num_workers": 4,
    "pin_memory": true,
    "persistent_workers": true,
    "align_to_bos": false,
    "train_context_length": 768,
    "use_random_loader": true,
    "eval_interval": 200,
    "eval_batches": 100,
    "eval_full_sweep": false,
    "eval_shuffle_documents": false,
    "logit_softcap": 20,
    "z_loss_weight": 1.5e-05,
    "use_ema_for_eval": false,
    "grad_accum_minutes_schedule": [
      {"minute": 0, "value": 2},
      {"minute": 15, "value": 4},
      {"minute": 45, "value": 8}
    ]
  },
  "data": {
    "train_path": "/data/data1/owt_train.npy",
    "val_path": "/data/data1/owt_valid.npy",
    "dtype": "uint16",
    "bos_token_id": null,
    "end_of_text_token_id": 31999
  },
  "checkpoint": {
    "checkpoint_dir": "checkpoints/owt_speedrun_sub3_final",
    "save_interval": 1000,
    "max_to_keep": 3,
    "resume_path": null
  },
  "logging": {
    "mode": "online",
    "entity": "vilhelm-toivonen-helsinki-university",
    "project": "cs336-owt",
    "run_name": "owt-sub3-final",
    "use_wandb": true,
    "log_interval": 10
  },
  "lr_schedule": {
    "enabled": true,
    "schedule_type": "cosine",
    "warmup_steps": 0,
    "cosine_steps": null,
    "warmup_tokens": null,
    "decay_tokens": null,
    "cosine_tokens": null
  }
}
