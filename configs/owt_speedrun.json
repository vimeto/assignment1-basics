{
  "model": {
    "vocab_size": 32000,
    "context_length": 512,
    "d_model": 1024,
    "num_layers": 12,
    "num_heads": 8,
    "d_ff": 4096,
    "rope_theta": 500000.0,
    "use_qk_norm": true,
    "use_unet_residual": true,
    "unet_gate_init": 0.10,
    "use_swiglu": false,
    "use_rmsnorm": true,
    "use_pre_norm": true,
    "use_post_norm": false,
    "use_rope": true,
    "use_x0_mixin": true,
    "x0_gate_init": 0.10,
    "tie_embeddings": false
  },
  "optimizer": {
    "name": "muon",
    "lr": 0.008,
    "betas": [0.65, 0.95],
    "eps": 1e-8,
    "weight_decay": 0.0,
    "matrix_weight_decay": 0.0,
    "vector_weight_decay": 0.0,
    "vector_lr_multiplier": 1.0,
    "muon_momentum": 0.95,
    "muon_momentum_min": 0.85,
    "muon_momentum_max": 0.95,
    "muon_warmup_steps": 300,
    "muon_momentum_cooldown_steps": 200,
    "muon_ns_steps": 5,
    "matrix_base_lr": 0.06,
    "vector_base_lr": 0.008,
    "muon_lr_decay_start": 1000,
    "muon_lr_decay_end": 16000,
    "muon_lr_decay_start_tokens": null,
    "muon_lr_decay_end_tokens": null,
    "muon_lr_final": 0.06,
    "muon_lr_warmup_steps": 100,
    "muon_lr_warmup_start": 0.006
  },
  "training": {
    "total_steps": 18000,
    "batch_size": 64,
    "grad_accum_steps": 4,
    "seed": 7,
    "device": "cuda",
    "precision": "bfloat16",
    "grad_clip_norm": 1.5,
    "step_interval": 1,
    "eval_interval": 100,
    "eval_batches": 32,
    "eval_batch_size": 64,
    "use_torch_compile": true,
    "compile_mode": "default",
    "use_gradient_checkpointing": false,
    "logit_softcap": 15.0,
    "z_loss_weight": 1e-4,
    "softcap_warmup_steps": 1000,
    "zloss_warmup_steps": 1000,
    "num_workers": 4,
    "pin_memory": true,
    "persistent_workers": true,
    "align_to_bos": true,
    "compile_warmup_steps": 20,
    "ema_decay": null,
    "ema_update_interval": 1,
    "use_ema_for_eval": false
  },
  "data": {
    "train_path": "/data0/data1/owt_train.npy",
    "val_path": "/data0/data1/owt_valid.npy",
    "dtype": "uint16",
    "bos_token_id": null
  },
  "checkpoint": {
    "checkpoint_dir": "./checkpoints/owt_speedrun",
    "save_interval": 1000,
    "max_to_keep": 3
  },
  "logging": {
    "log_interval": 10,
    "use_wandb": true,
    "project": "cs336-owt",
    "entity": "vilhelm-toivonen-helsinki-university",
    "run_name": "owt_speedrun"
  },
  "lr_schedule": {
    "enabled": true,
    "schedule_type": "cosine",
    "alpha_max": 0.008,
    "alpha_min": 0.0008,
    "warmup_steps": 1000,
    "cosine_steps": 16000,
    "warmup_tokens": null,
    "decay_tokens": null,
    "cosine_tokens": null
  }
}
