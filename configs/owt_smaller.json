{
  "model": {
    "vocab_size": 32000,
    "context_length": 512,
    "d_model": 1024,
    "num_layers": 12,
    "num_heads": 8,
    "d_ff": 2688,
    "rope_theta": 10000.0,
    "use_qk_norm": true,
    "use_unet_residual": false,
    "use_swiglu": true,
    "use_rmsnorm": true,
    "use_pre_norm": true,
    "use_post_norm": false,
    "use_rope": true,
    "use_x0_mixin": false,
    "tie_embeddings": true
  },
  "optimizer": {
    "name": "muon",
    "lr": 0.003,
    "betas": [0.9, 0.999],
    "eps": 1e-8,
    "weight_decay": 0.02,
    "matrix_weight_decay": 0.01,
    "vector_weight_decay": 0.0,
    "vector_lr_multiplier": 1.0,
    "muon_momentum": 0.95,
    "muon_momentum_min": 0.9,
    "muon_momentum_max": 0.95,
    "muon_warmup_steps": 300,
    "muon_ns_steps": 5,
    "matrix_base_lr": 0.012,
    "vector_base_lr": 0.003,
    "muon_lr_decay_start_tokens": 40000000,
    "muon_lr_decay_end_tokens": 400000000,
    "muon_lr_final": 0.007
  },
  "training": {
    "total_steps": 6000,
    "batch_size": 96,
    "grad_accum_steps": 8,
    "pin_memory": true,
    "num_workers": 8,
    "persistent_workers": true,
    "seed": 7,
    "device": "cuda",
    "precision": "bfloat16",
    "grad_clip_norm": 1.5,
    "step_interval": 1,
    "eval_interval": 100,
    "eval_batches": 32,
    "eval_batch_size": 96,
    "use_torch_compile": true,
    "compile_mode": "default",
    "use_gradient_checkpointing": false,
    "logit_softcap": 20.0,
    "z_loss_weight": 5.0e-5,
    "softcap_warmup_steps": 1000,
    "zloss_warmup_steps": 1000
  },
  "data": {
    "train_path": "/data0/data1/owt_train.npy",
    "val_path": "/data0/data1/owt_valid.npy",
    "dtype": "uint16"
  },
  "checkpoint": {
    "checkpoint_dir": "./checkpoints/owt_124m_fast",
    "save_interval": 1000,
    "max_to_keep": 3
  },
  "logging": {
    "log_interval": 10,
    "use_wandb": true,
    "project": "cs336-owt",
    "entity": "vilhelm-toivonen-helsinki-university",
    "run_name": "owt_124m_fast"
  },
  "lr_schedule": {
    "enabled": true,
    "schedule_type": "cosine",
    "alpha_max": 0.003,
    "alpha_min": 0.0007,
    "warmup_tokens": 40000000,
    "cosine_tokens": 800000000
  }
}
